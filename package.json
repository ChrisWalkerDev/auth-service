{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Secure authentication and authorization system on Cloudflare",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply auth-service-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply auth-service-db --remote",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:chriswalker": "wrangler deploy -c wrangler.chriswalker.toml",
    "db:migrate:chriswalker": "wrangler d1 migrations apply auth-chriswalker-db --remote -c wrangler.chriswalker.toml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-auth": "^1.7.14",
    "hono": "^4.13.14",
    "wrangler": "^4.153.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^26.6.5",
    "jose": "^6.2.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
